# RPC endpoint of the node (local Anvil by default)
RPC_URL=http://127.0.0.1:8545
# Chain ID of the target network (31337 for Anvil)
CHAIN_ID=31337
# Address of the deployed Vault contract
VAULT_ADDRESS=0x...
# Address of the deployed Controller contract
CONTROLLER_ADDRESS=0x...
# Private key of the authorized backend account (never commit the real one)
BACKEND_PRIVATE_KEY=0x...